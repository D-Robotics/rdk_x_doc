# Algolia Admin / Write API Key（仅用于 scripts/algolia-index.mjs，不要提交真实值）
# GitHub Actions 请在仓库 Settings → Secrets 中配置同名 ALGOLIA_ADMIN_API_KEY
ALGOLIA_ADMIN_API_KEY=

# 可选覆盖（默认与 docusaurus.config.js 中的公开配置一致）
# ALGOLIA_APP_ID=1VU781LYTV
# ALGOLIA_INDEX_NAME=rdk_x_doc
# ALGOLIA_SITE_URL=https://developer.d-robotics.cc/rdk_x_doc/

# 若本机代理导致 Algolia API 403，可设为 1 以绕过代理
# ALGOLIA_NO_PROXY=1
